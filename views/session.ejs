<%- include('partials/header', { title: campaign.name, extraCss: 'session.css', extraJs: undefined }) %>
<link rel="stylesheet" href="/css/gallery.css">
<!-- ── VIEWPORT ─────────────────────────────────── -->
<div id="viewport">
  <div id="mapLayer">
    <div id="gridOverlay"></div>
    <img id="mapImage" src="" alt="" draggable="false">
    <div id="tokenLayer"></div>
    <!-- Fog of War: canvas dentro do mapLayer (segue pan/zoom) -->
    <canvas id="fogCanvas" style="position:absolute;top:0;left:0;pointer-events:none;opacity:0;"></canvas>
    <!-- AoE Measurement overlay (above fog, below HUD) -->
    <canvas id="overlayCanvas" style="position:absolute;top:0;left:0;pointer-events:none;z-index:18;"></canvas>    
    <div id="noMap">
      <div class="no-map-inner">
        <span>🗺</span>
        <p>Nenhuma cena ativa</p>
        <small>Crie uma cena no painel lateral para começar</small>
      </div>
    </div>
  </div>
</div>

<!-- ── HUD LATERAL ───────────────────────────────── -->
<aside class="hud" id="hud">

  <div class="hud-title">
    <span class="hud-rune">⚔</span>
    <div>
      <strong><%= campaign.name %></strong>
      <span class="hud-label">Sessão Ativa</span>
    </div>
  </div>

  <div class="hud-divider"></div>

  <!-- CENAS -->
  <div class="hud-section">
    <div class="hud-section-header">
      <p class="hud-section-label">Cenas</p>
      <button class="hud-icon-btn" id="btnNewScene" title="Nova cena">＋</button>
    </div>

    <!-- Form nova cena (colapsável) -->
    <div class="scene-form collapsed" id="sceneForm">
      <input class="tf-input" id="sfName"  type="text"  placeholder="Nome da cena" maxlength="40" autocomplete="off">
      <textarea class="tf-input tf-textarea" id="sfUrl" placeholder="Cole a URL da imagem (https://…)" rows="2"></textarea>
      <div class="scene-form-or">
        <span>ou</span>
      </div>
      <label class="hud-btn hud-btn--file">
        <input type="file" id="sfFile" accept="image/*" hidden>
        <span class="hud-icon">📁</span><span>Arquivo local</span>
      </label>
      <button class="hud-btn hud-btn--accent" id="sfSubmit">
        <span class="hud-icon">✦</span><span>Criar Cena</span>
      </button>
    </div>

    <!-- Lista de cenas -->
    <div class="scene-list" id="sceneList">
      <p class="empty-hint" id="sceneEmptyHint">Nenhuma cena criada.</p>
    </div>
  </div>

  <div class="hud-divider"></div>

  <!-- MAPA -->
  <div class="hud-section">
    <p class="hud-section-label">Visão</p>
    <button class="hud-btn" id="btnReset">
      <span class="hud-icon">⊙</span><span>Resetar Visão</span>
    </button>
    <button class="hud-btn" id="btnGrid">
      <span class="hud-icon" id="gridIcon">⊞</span>
      <span id="gridLabel">Mostrar Grade</span>
    </button>
  </div>

  <div class="hud-divider"></div>

  <!-- TOKENS -->
  <div class="hud-section">
    <p class="hud-section-label">Tokens</p>
    <button class="hud-btn" id="btnAddToken">
      <span class="hud-icon">＋</span><span>Adicionar Token</span>
    </button>
    <div class="token-form collapsed" id="tokenForm">
      <input class="tf-input" id="tfName" type="text" placeholder="Nome do token" maxlength="24" autocomplete="off">
      <div class="tf-row">
        <div class="tf-color-group">
          <span class="tf-label">Cor</span>
          <div class="tf-swatches" id="tfSwatches"></div>
        </div>
        <div class="tf-size-group">
          <span class="tf-label">Tam.</span>
          <div class="tf-size-btns">
            <button class="tf-size active" data-size="1">1×1</button>
            <button class="tf-size"        data-size="2">2×2</button>
          </div>
        </div>
      </div>
      <button class="hud-btn hud-btn--accent" id="tfSubmit">
        <span class="hud-icon">✦</span><span>Criar Token</span>
      </button>
    </div>
  </div>

  <div class="hud-divider"></div>

  <!-- DADOS -->
  <div class="hud-section">
    <p class="hud-section-label">Dados</p>
    <div class="dice-panel" id="dicePanel">
      <button class="die-btn" data-faces="4">d4</button>
      <button class="die-btn" data-faces="6">d6</button>
      <button class="die-btn" data-faces="8">d8</button>
      <button class="die-btn" data-faces="10">d10</button>
      <button class="die-btn" data-faces="12">d12</button>
      <button class="die-btn die-btn--d20" data-faces="20">d20</button>
    </div>
    <button class="hud-btn" id="btnToggleLog">
      <span class="hud-icon">📜</span><span>Histórico</span>
    </button>
  </div>

  <div class="hud-divider"></div>

  <!-- NOTAS -->
  <div class="hud-section">
    <p class="hud-section-label">Mestre</p>
    <button class="hud-btn" id="btnNotes">
      <span class="hud-icon">✏</span><span>Notas</span>
    </button>
    <!-- Névoa de Guerra -->
    <button class="hud-btn" id="btnFog">
      <span class="hud-icon">🌫️</span><span>Névoa de Guerra</span>
    </button>
    <div class="fog-tool-panel hidden" id="fogToolPanel">
      <div class="fog-tools">
        <button class="fog-tool active" data-tool="hide" id="fogToolHide">⬛ Esconder</button>
        <button class="fog-tool" data-tool="reveal" id="fogToolReveal">⬜ Revelar</button>
      </div>
      
      <div style="display: flex; gap: 4px; margin-top: 4px;">
        <button class="hud-btn" id="btnToggleFogView" title="Alternar Visão do Mestre" style="flex:1;">
          <span class="hud-icon">👁️</span><span id="fogViewLabel">Ocultar Névoa</span>
        </button>
        <button class="hud-btn hud-btn--danger" id="btnFogClear" title="Resetar Tudo" style="width: 40px; justify-content: center;">
          <span class="hud-icon">✕</span>
        </button>
      </div>
    </div>
    <button class="hud-btn active" id="btnToggleAuras">
      <span class="hud-icon">👁</span><span id="auraLabel">Auras</span>
    </button>
  </div>

  <div class="hud-divider"></div>

  <!-- AoE MEASUREMENT -->
  <div class="hud-section">
    <p class="hud-section-label">Medição AoE</p>
    <div class="measure-btns">
      <button class="measure-tool-btn" id="btnMeasureLine"   title="Linha reta (5ft de largura)">━ Linha</button>
      <button class="measure-tool-btn" id="btnMeasureCone"   title="Cone (53°)">◭ Cone</button>
      <button class="measure-tool-btn" id="btnMeasureCircle" title="Círculo/Esfera">◎ Círculo</button>
    </div>
    <div class="measure-range-row hidden" id="measureRangePanel">
      <span class="hud-label-sm">Alcance</span>
      <input type="number" id="measureRange" value="30" min="5" step="5" class="measure-input">
      <span class="hud-label-sm">ft</span>
    </div>
    <button class="hud-btn" id="btnMeasureClear">
      <span class="hud-icon">🗑</span><span>Limpar</span>
    </button>
  </div>
  
  <div class="hud-divider"></div>

  <div class="hud-zoom-info">
    <span class="hud-label">Zoom</span>
    <span id="zoomDisplay">100%</span>
  </div>

  <a href="/" class="hud-btn hud-btn--danger">
    <span class="hud-icon">←</span><span>Dashboard</span>
  </a>

</aside>

<!-- ── GALLERY TOGGLE (right edge) ──────────── -->
<button class="gallery-toggle" id="btnGalleryToggle" title="Galeria de Tokens">
  <span>⇦</span>
</button>

<!-- ── GALLERY SIDEBAR (right) ──────────────── -->
<aside class="gallery-sidebar" id="gallerySidebar">
  <div class="gallery-header">
    <span class="gallery-title">⚄ Galeria</span>
    <button class="drawer-close" id="btnGalleryClose">✕</button>
  </div>

  <!-- Tabs -->
  <div class="gallery-tabs">
    <button class="gtab active" data-cat="player">Jogadores</button>
    <button class="gtab" data-cat="npc">NPCs</button>
    <button class="gtab" data-cat="enemy">Inimigos</button>
  </div>

  <!-- Template list (rendered per tab) -->
  <div class="gallery-list" id="galleryList"></div>

  <!-- New template form -->
  <div class="gallery-footer">
    <button class="hud-btn hud-btn--accent" id="btnNewTemplate">
      <span class="hud-icon">＋</span><span>Novo Template</span>
    </button>
  </div>
</aside>

<!-- ── TEMPLATE FORM MODAL ───────────────────── -->
<div class="modal-backdrop hidden" id="tplModalBackdrop">
  <div class="tpl-modal">
    <div class="tpl-modal-header">
      <span id="tplModalTitle">Novo Template</span>
      <button class="drawer-close" id="btnTplModalClose">✕</button>
    </div>
    <div class="tpl-modal-body">
      <label class="field">
        <span>Nome *</span>
        <input class="tf-input" id="tplName" type="text" placeholder="Goblin Arqueiro" maxlength="50" autocomplete="off">
      </label>
      <div class="tpl-row">
        <label class="field" style="flex:1">
          <span>Categoria</span>
          <select class="tf-input" id="tplCategory">
            <option value="player">Jogador</option>
            <option value="npc" selected>NPC</option>
            <option value="enemy">Inimigo</option>
          </select>
        </label>
        <label class="field" style="flex:1">
          <span>Tamanho</span>
          <select class="tf-input" id="tplSize">
            <option value="1x1" selected>1×1 Pequeno</option>
            <option value="2x2">2×2 Grande</option>
            <option value="3x3">3×3 Enorme</option>
          </select>
        </label>
      </div>
      <label class="field">
        <span>Cor</span>
        <div class="tpl-swatches" id="tplSwatches"></div>
      </label>
      <label class="field">
        <span>Imagem (URL ou base64)</span>
        <div style="display:flex;gap:.5rem;">
          <input class="tf-input" id="tplImageUrl" type="text" placeholder="https://… ou deixe vazio" style="flex:1">
          <label class="hud-btn hud-btn--file" style="width:auto;white-space:nowrap">
            <input type="file" id="tplImageFile" accept="image/*" hidden>
            📁
          </label>
        </div>
      </label>
      <!-- HP lives in sheet_data JSON — edit via "📋 Editar Ficha" -->
    </div>
    <div class="tpl-modal-footer">
      <button class="hud-btn" id="btnTplModalCancel">Cancelar</button>
      <button class="hud-btn hud-btn--accent" id="btnTplModalSave">Salvar Template</button>
    </div>
  </div>
</div>

<!-- ── CHARACTER SHEET PANEL ─────────────────── -->
<div class="sheet-panel hidden" id="sheetPanel">
  <div class="sheet-panel-header">
    <span class="sheet-panel-title" id="sheetPanelTitle">Ficha</span>
    <div style="display:flex;align-items:center;gap:.6rem;">
      <span class="notes-saved" id="sheetSaved"></span>
      <button class="drawer-close" id="btnSheetClose">✕</button>
    </div>
  </div>
  <div class="sheet-body" id="sheetBody">
    <!-- Renderizado dinamicamente por sheet.js -->
  </div>
</div>

<!-- ── LOG DRAWER ─────────────────────────────────── -->
<div class="side-drawer" id="logDrawer">
  <div class="drawer-header">
    <span class="drawer-title">📜 Histórico de Dados</span>
    <button class="drawer-close" id="btnCloseLog">✕</button>
  </div>
  <ul class="log-list" id="logList"></ul>
</div>

<!-- ── NOTES DRAWER ───────────────────────────────── -->
<div class="side-drawer notes-drawer" id="notesDrawer">
  <div class="drawer-header">
    <span class="drawer-title">✏ Notas</span>
    <button class="hud-btn hud-btn--accent hud-btn--sm" id="btnNewNote">＋ Nova</button>
    <button class="drawer-close" id="btnCloseNotes">✕</button>
  </div>

  <!-- Lista de notas -->
  <div class="notes-list" id="notesList">
    <p class="empty-hint" id="notesEmptyHint">Nenhuma nota ainda.</p>
  </div>

  <!-- Editor de nota (hidden por padrão) -->
  <div class="note-editor hidden" id="noteEditor">
    <div class="note-editor-header">
      <button class="drawer-close" id="btnBackNotes" title="Voltar">←</button>
      <input class="note-title-input" id="noteTitleInput" type="text" placeholder="Título da nota" maxlength="60">
      <div class="note-editor-actions">
        <span class="notes-saved" id="notesSaved"></span>
        <button class="ctx-item ctx-item--danger" id="btnDeleteNote" title="Excluir nota">✕</button>
      </div>
    </div>
    <textarea class="notes-area" id="notesArea" placeholder="Conteúdo da nota…"></textarea>
  </div>
</div>

<!-- ── CONTEXT MENU ────────────────────────────────── -->
<div class="ctx-menu hidden" id="ctxMenu">
  <button class="ctx-item" id="ctxOpenSheet">📋 Abrir Ficha</button>
  <div style="height:1px;background:rgba(255,255,255,.07);margin:.25rem 0;"></div>
  <button class="ctx-item ctx-item--danger" id="ctxDelete">✕ Excluir Token</button>
</div>

<!-- ── CONTROLS HINT ──────────────────────────────── -->
<div class="controls-hint">
  <span>🖱 Roda — Zoom</span>
  <span>⊞ Btn Dir. — Pan</span>
  <span>✦ Arrastar — Mover Token</span>
</div>

<script>window.CAMPAIGN_ID = '<%= campaign.id %>';</script>
<script src="/js/tabletop.js" type="module"></script>
<script src="/js/gallery.js" type="module"></script>
<script src="/js/sheet.js"   type="module"></script>
<%- include('partials/footer', {}) %>
